rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection Path: /artifacts/{appId}/public/{allPaths=**}
    // Specific Document: /artifacts/{appId}/public/data/di_system_records/master_state
    //
    // Description:
    //   Master system state document holding application configurations,
    //   personnel directory, attendance, armory, duty logs, and user credentials.
    //
    // Fields:
    //   - updatedAt: string (ISO 8601 timestamp string, max 100 characters)
    //   - syncReason: string (event trigger identifier, max 100 characters)
    //   - rankDefinitionsVersion: int or float (numerical version identifier)
    //   - RANK_DEFINITIONS: map (nested rank lookup definitions)
    //   - POSITION_DEFINITIONS: map (nested position lookup definitions)
    //   - staffTypeList: list (array of staff categories, max 5000 items)
    //   - statusList: list (array of active/leave statuses, max 5000 items)
    //   - addressTypeList: list (array of address classifications, max 5000 items)
    //   - securityDutyTypeList: list (array of security shift types, max 5000 items)
    //   - armoryCategoryList: list (array of weapon/gear categories, max 5000 items)
    //   - armoryStatusList: list (array of armory conditions, max 5000 items)
    //   - raceList: list (array of ethnicities, max 5000 items)
    //   - religionList: list (array of religions, max 5000 items)
    //   - absentReasonCategories: list (array of absent categories, max 5000 items)
    //   - absentReasonRows: list (array of absence entries, max 20000 items)
    //   - DEPT_MAPPING: list (array of department objects, max 5000 items)
    //   - personnelData: list (array of staff records, max 20000 items)
    //   - securityDutyData: list (array of duty logs, max 20000 items)
    //   - armoryData: list (array of armory inventory records, max 20000 items)
    //   - prodStatementData: list (array of production records, max 20000 items)
    //   - announcementData: list (array of announcement items, max 5000 items)
    //   - userRoles: list (array of user roles, max 1000 items)
    //   - userData: list (array of user login records, max 5000 items)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if user is signed in with Firebase Authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Validate valid App ID format (1-128 characters)
    function isValidAppId(appId) {
      return appId is string && appId.size() >= 1 && appId.size() <= 128;
    }

    // Optional string length validator
    function isValidOptionalString(fieldName, minLen, maxLen) {
      return !(fieldName in request.resource.data) ||
        (request.resource.data[fieldName] is string &&
         request.resource.data[fieldName].size() >= minLen &&
         request.resource.data[fieldName].size() <= maxLen);
    }

    // Optional list size validator
    function isValidOptionalList(fieldName, maxItems) {
      return !(fieldName in request.resource.data) ||
        (request.resource.data[fieldName] is list &&
         request.resource.data[fieldName].size() <= maxItems);
    }

    // Optional map validator
    function isValidOptionalMap(fieldName) {
      return !(fieldName in request.resource.data) ||
        (request.resource.data[fieldName] is map);
    }

    // Optional number validator
    function isValidOptionalNumber(fieldName) {
      return !(fieldName in request.resource.data) ||
        (request.resource.data[fieldName] is int ||
         request.resource.data[fieldName] is float ||
         request.resource.data[fieldName] is number);
    }

    // Validate document schema and size bounds to prevent resource exhaustion / DoS
    function isValidMasterStatePayload() {
      return request.resource.data.keys().size() <= 50 &&
        isValidOptionalString('updatedAt', 1, 100) &&
        isValidOptionalString('syncReason', 1, 100) &&
        isValidOptionalNumber('rankDefinitionsVersion') &&
        isValidOptionalMap('RANK_DEFINITIONS') &&
        isValidOptionalMap('POSITION_DEFINITIONS') &&
        isValidOptionalList('staffTypeList', 5000) &&
        isValidOptionalList('statusList', 5000) &&
        isValidOptionalList('addressTypeList', 5000) &&
        isValidOptionalList('securityDutyTypeList', 5000) &&
        isValidOptionalList('armoryCategoryList', 5000) &&
        isValidOptionalList('armoryStatusList', 5000) &&
        isValidOptionalList('raceList', 5000) &&
        isValidOptionalList('religionList', 5000) &&
        isValidOptionalList('absentReasonCategories', 5000) &&
        isValidOptionalList('absentReasonRows', 20000) &&
        isValidOptionalList('DEPT_MAPPING', 5000) &&
        isValidOptionalList('personnelData', 20000) &&
        isValidOptionalList('securityDutyData', 20000) &&
        isValidOptionalList('armoryData', 20000) &&
        isValidOptionalList('prodStatementData', 20000) &&
        isValidOptionalList('announcementData', 5000) &&
        isValidOptionalList('userRoles', 1000) &&
        isValidOptionalList('userData', 5000);
    }

    // ===============================================================
    // Rules Matching
    // ===============================================================

    // Public artifact storage for the application state
    // Accommodates unauthenticated clients and Firebase Auth accounts
    match /artifacts/{appId}/public/{allPaths=**} {
      // Allow read access for public artifact records
      allow read: if isValidAppId(appId);

      // Domain Validator Pattern: Validate structure on both create and update
      allow create: if isValidAppId(appId) && isValidMasterStatePayload();
      allow update: if isValidAppId(appId) && isValidMasterStatePayload();

      // Prevent malicious or unauthenticated deletion of the master state
      allow delete: if isAuthenticated();
    }

    // Optional user-scoped data if future personal sync is used
    match /users/{userId}/{document=**} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ===============================================================
    // Default Deny
    // ===============================================================
    // All other collections and documents deny any read or write access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
